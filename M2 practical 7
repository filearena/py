import pandas as pd
# Load CSV file
df = pd.read_csv("students.csv")

# Display the dataset
print("Student Dataset:")
print(df)

# Display statistical summary
print("\nStatistical Summary:")
print(df.describe())

# Calculate mean
print("\nMean:")
print(df["Marks"].mean())

# Calculate median
print("\nMedian:")
print(df["Marks"].median())
# Calculate mode
print("\nMode:")
print(df["Marks"].mode()[0])
# Calculate minimum
print("\nMinimum:")
print(df["Marks"].min())
# Calculate maximum
print("\nMaximum:")
print(df["Marks"].max())
# Calculate standard deviation
print("\nStandard Deviation:")
print(df["Marks"].std())
# Calculate variance
print("\nVariance:")
print(df["Marks"].var())
